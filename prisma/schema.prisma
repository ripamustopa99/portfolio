// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  sessions          Session[]

  @@map("users")
}

model Session {
  id        String   @id // session token hash
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model RateLimit {
   key       String   @id
   count     Int      @default(1)
   resetTime DateTime @map("reset_time")

   @@map("rate_limits")
}

model Setting {
   key       String   @id
   value     String
   updatedAt DateTime @updatedAt @map("updated_at")

   @@map("settings")
}

model AnalyticsEvent {
   id        String   @id @default(uuid())
   eventType String   @map("event_type")
   target    String?
   visitorId String?  @map("visitor_id")
   ipAddress String?  @map("ip_address")
   createdAt DateTime @default(now()) @map("created_at")

   @@map("analytics_events")
}

model Project {
  id                String   @id @default(uuid())
  slug              String
  title             String
  description       String
  language          String   @default("en") // "en" or "id"
  date              DateTime
  thumbnail         String?
  animationVideoUrl String?  @map("animation_video_url") // Dribbble-style video preview
  tags              String[]
  techStack         String?  @map("tech_stack") // Stored as JSON string
  links             String?  // Stored as JSON string
  featured          Boolean  @default(false)
  content           String   // Markdown / HTML content
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([slug, language])
  @@map("projects")
}

model Note {
  id          String   @id @default(uuid())
  slug        String
  title       String
  description String
  language    String   @default("en") // "en" or "id"
  date        DateTime
  tags        String[]
  content     String   // Markdown / HTML content
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slug, language])
  @@map("notes")
}

model Media {
  id           String   @id @default(uuid())
  url          String
  publicId     String   @map("public_id")
  resourceType String   @map("resource_type") // image, video
  filename     String?
  category     String   @default("universal") // universal, projects, notes
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("media")
}
